<Window x:Class="SampAccountManager.WPF.Views.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cont" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22">
        <TextBlock x:Name="Heading" Style="{StaticResource H1}" Margin="0,0,0,14" />
        <TextBlock Text="Nickname (3-24 caractere)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
        <TextBox x:Name="NickBox" MaxLength="24" Margin="0,0,0,12" />
        <TextBlock x:Name="PassLabel" Text="Parola" Style="{StaticResource Muted}" Margin="0,0,0,4" />
        <PasswordBox x:Name="PassBox" Margin="0,0,0,12" />
        <TextBlock Text="Note (optional)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
        <TextBox x:Name="NotesBox" Margin="0,0,0,12" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuleaza" IsCancel="True" />
            <Button Content="Salveaza" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
