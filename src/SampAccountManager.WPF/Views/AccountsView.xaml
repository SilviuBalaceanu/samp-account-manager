<UserControl x:Class="SampAccountManager.WPF.Views.AccountsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Accounts" Style="{StaticResource H1}" />
            <TextBlock Text="Parolele sunt protejate cu DPAPI si nu apar in loguri." Style="{StaticResource Muted}" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="+ Adauga" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" />
                <Button Content="Editeaza" Command="{Binding EditCommand}" />
                <Button Content="Sterge" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0" />
            </StackPanel>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" ToolTip="Cauta dupa nickname" />
        </DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="CONNECT" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}" Width="120" />
                <Button Content="DISCONNECT" Command="{Binding DisconnectCommand}" Width="120" />
                <Button Content="RECONNECT" Command="{Binding ReconnectCommand}" Width="120" />
                <TextBlock Text="Se foloseste serverul selectat in pagina Servers (altfel, cel implicit)." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
        <ListBox ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}" ItemContainerStyle="{StaticResource RowItem}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Nickname}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LastUsedText}" Style="{StaticResource Muted}" FontSize="12" />
                            <TextBlock Text="{Binding Notes}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding Notes, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                            <TextBlock Text="{Binding StateLabel}" Foreground="{Binding State, Converter={StaticResource StateBrush}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
