<UserControl x:Class="SampAccountManager.WPF.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Dashboard" Style="{StaticResource H1}" />
            <TextBlock Text="Starea reala a conturilor si sesiunilor. 'Sesiuni active' numara doar sesiunile cu spawn confirmat de server." Style="{StaticResource Muted}" />
        </StackPanel>
        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,-12,0">
            <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel>
                <TextBlock Text="Conturi totale" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding TotalAccounts}" FontSize="30" FontWeight="SemiBold" />
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel>
                <TextBlock Text="Sesiuni active confirmate" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding ConfirmedSessions}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}" />
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel>
                <TextBlock Text="Starea conexiunilor" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding ConnectionSummary}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel>
                <TextBlock Text="Cont selectat" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding SelectedAccount}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel>
                <TextBlock Text="Ultimul cont utilizat" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding LastUsedAccount}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12"><StackPanel>
                <TextBlock Text="Server selectat" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding SelectedServer}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel></Border>
        </UniformGrid>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Istoric activitate" Style="{StaticResource H2}" />
                <ListBox ItemsSource="{Binding Activity}" />
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
