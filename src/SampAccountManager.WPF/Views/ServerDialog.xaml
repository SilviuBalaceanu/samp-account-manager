<Window x:Class="SampAccountManager.WPF.Views.ServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22">
        <TextBlock x:Name="Heading" Style="{StaticResource H1}" Margin="0,0,0,14" />
        <TextBlock Text="Nume" Style="{StaticResource Muted}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Margin="0,0,0,12" />
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="IP / host" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                <TextBox x:Name="HostBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Port" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                <TextBox x:Name="PortBox" Text="7777" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Descriere" Style="{StaticResource Muted}" Margin="0,0,0,4" />
        <TextBox x:Name="DescBox" Margin="0,0,0,12" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuleaza" IsCancel="True" />
            <Button Content="Salveaza" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
